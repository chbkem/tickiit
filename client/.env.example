# Copy to .env.local (gitignored) for local development.
# CRA inlines REACT_APP_* values at build time, so production builds must set
# REACT_APP_API_BASE_URL in the build environment, not at runtime.

# Backend URL. Development: the API port from server/.env (5000 by default).
# Production: your deployed API origin, e.g. https://api.example.com
REACT_APP_API_BASE_URL=http://localhost:5000

REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_...
REACT_APP_CLERK_AFTER_SIGN_OUT_URL=/
