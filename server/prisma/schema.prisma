generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id             String     @id @default(uuid())
  ticketNumber   String     @unique
  subject        String
  description    String?
  status         Status     @default(OPEN)
  priority       Priority   @default(MEDIUM)
  type           TicketType @default(TASK)
  requesterId    String
  requesterName  String?
  requesterEmail String?
  requesterKey   String?
  assigneeId     String?
  orgId          String?
  formId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  resolvedAt     DateTime?
  closedAt       DateTime?
  dueAt          DateTime?
  source         String
  isSpam         Boolean    @default(false)
  spamScore      Int        @default(0)
  spamReasons    String[]   @default([])
  quarantinedAt  DateTime?
  comments       Comment[]

  @@index([requesterKey])
  @@index([orgId, assigneeId, status])
  @@index([formId])
  @@index([orgId, isSpam, createdAt])
}

model FormSubmissionAttempt {
  id          String         @id @default(uuid())
  formId      String?
  publicId    String
  ipHash      String
  emailHash   String?
  emailDomain String?
  bodyHash    String?
  verdict     AttemptVerdict
  score       Int            @default(0)
  reasons     String[]       @default([])
  ticketId    String?
  createdAt   DateTime       @default(now())

  @@index([ipHash, createdAt])
  @@index([emailHash, createdAt])
  @@index([bodyHash, createdAt])
  @@index([formId, createdAt])
  @@index([verdict, createdAt])
  @@index([createdAt])
}

model BlocklistEntry {
  id        String        @id @default(uuid())
  kind      BlocklistKind
  value     String
  reason    String?
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime      @default(now())

  @@unique([kind, value])
}

model TicketForm {
  id          String   @id @default(uuid())
  publicId    String   @unique
  name        String
  description String?
  orgId       String
  orgName     String?
  createdBy   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
}

model Comment {
  id        String       @id @default(uuid())
  ticketId  String
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime     @default(now())
}

enum Status {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  TASK
  BUG
  INCIDENT
  REQUEST
}

enum AttemptVerdict {
  ACCEPTED
  QUARANTINED
  REJECTED
}

enum BlocklistKind {
  EMAIL
  DOMAIN
  IP
}