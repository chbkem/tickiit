generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id             String     @id @default(uuid())
  ticketNumber   String     @unique
  subject        String
  description    String?
  status         Status     @default(OPEN)
  priority       Priority   @default(MEDIUM)
  type           TicketType @default(TASK)
  requesterId    String
  requesterName  String?
  requesterEmail String?
  requesterKey   String?
  assigneeId     String?
  orgId          String?
  formId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  resolvedAt     DateTime?
  closedAt       DateTime?
  dueAt          DateTime?
  source         String
  comments       Comment[]
  accessTokens   TicketAccessToken[]

  @@index([requesterKey])
  @@index([orgId, assigneeId, status])
  @@index([formId])
}

model TicketForm {
  id          String   @id @default(uuid())
  publicId    String   @unique
  name        String
  description String?
  orgId       String
  orgName     String?
  createdBy   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
}

model Comment {
  id         String            @id @default(uuid())
  ticketId   String
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  body       String
  visibility CommentVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now())
}

model TicketAccessToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([ticketId, expiresAt])
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
  CUSTOMER
}

enum Status {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  TASK
  BUG
  INCIDENT
  REQUEST
}
