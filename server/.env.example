# --- Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000

# --- Database (Prisma ORM 7 / adapter-pg) ---
# Prisma generates the client with adapter-pg (src/lib/prisma.js).
# DATABASE_URL goes through Supabase pgbouncer transaction pooling.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- AI triage (POST /api/ai/triage) ---
# Shared-secret bearer token for channel adapters/webhooks (Authorization: Bearer or x-ingest-token).
# Unset => the triage endpoint is disabled (503).
AI_INGEST_TOKEN=

# Master kill-switch for the AI/model egress path. "false" disables every model
# call; triage still runs and tickets are still created deterministically
# (type TASK, priority MEDIUM). Defaults to "true".
AI_ENABLED=true

# Per-model-call timeout in milliseconds. A provider that hangs past this is
# aborted and the stage degrades to its deterministic fallback. 0 disables.
AI_TIMEOUT_MS=15000

# Per-request model-spend cap in total tokens (accumulated across all agent
# stages). When the running total would exceed this, the remaining model
# stages are skipped and the deterministic fallback is used (ticket is still
# created). 0 or unset => unlimited.
AI_MAX_TOKENS_PER_REQUEST=20000

# Provider/model for the triage agents (Vercel AI SDK).
# v1 supports "gemini" only; other providers plug into src/ai/model.js later.
AI_PROVIDER=gemini
# Google API key; GOOGLE_GENERATIVE_AI_API_KEY is preferred, GEMINI_API_KEY is a fallback.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Optional customer-facing draft reply. "false" or unset => no auto-reply unless
# the request explicitly passes autoReply:true.
AI_AUTO_REPLY=false

# --- Knowledge base embeddings (local Transformer.js) ---
# Small local ONNX model that embeds knowledge chunks for pgvector search.
# Retrieval falls back to tag/keyword matching when the model is unavailable.
AI_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
AI_EMBEDDING_DIM=384
AI_EMBEDDING_TOP_K=5
# Optional directory to cache model weights (defaults to the library cache dir).
AI_EMBEDDING_CACHE_DIR=

# --- Knowledge base uploads ---
# Per file upload cap in bytes. Defaults to 10 MB.
KB_MAX_UPLOAD_BYTES=10485760
# Cap on text extracted from an uploaded document, in characters. Defaults to 1,000,000.
KB_MAX_TEXT_CHARS=1000000

# --- Omnichannel intake (email + Telegram) ---
# Local SMTP server that receives inbound email and forwards it to the email webhook.
CHANNEL_SMTP_HOST=127.0.0.1
CHANNEL_SMTP_PORT=2525
# Shared secret the SMTP server sends to the webhook (x-webhook-secret). Unset => webhook returns 503.
CHANNEL_SMTP_WEBHOOK_SECRET=
# Base URL the SMTP server calls to deliver inbound email to the app.
CHANNEL_SMTP_WEBHOOK_URL=http://localhost:5000/api/channels/email/webhook

# Telegram bot for sending replies via the Bot API. Unset => Telegram replies are skipped.
CHANNEL_TELEGRAM_BOT_TOKEN=
# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token. Unset => webhook returns 503.
CHANNEL_TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL Telegram pushes updates to (must route to /api/channels/telegram/webhook/:botUsername).
CHANNEL_TELEGRAM_WEBHOOK_URL=

# SMTP credentials for sending email replies via nodemailer. Unset host => replies are skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=