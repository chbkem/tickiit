# --- Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000

# --- Database (Prisma ORM 7 / adapter-pg) ---
# DATABASE_URL goes through Supabase pgbouncer transaction pooling.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# pgBoss and Prisma migrations must connect DIRECT (port 5432), bypassing pgBouncer.
DIRECT_URL=postgresql://USER:PASSWORD@aws-0-REGION.supabase.com:5432/postgres

# PgBoss connection string; defaults to DIRECT_URL when unset.
PGBOSS_CONNECTION_STRING=

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- AI ingest (POST /api/ai/ingest) ---
# Shared-secret bearer token for channel adapters/webhooks. Unset => ingest disabled (503).
AI_INGEST_TOKEN=

# --- AI provider (BYOM - bring your own model) ---
# OpenAI-compatible wire protocol: OpenAI, Azure, Groq, Mistral, Together, Ollama, LM Studio, vLLM...
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Pipeline behavior ---
# Confidence gate: decisions at/above this score auto-apply, below go to review.
AI_CONFIDENCE_THRESHOLD=0.7
# "review" (default) or "deterministic": whether fallback/offline decisions auto-apply.
AI_FALLBACK_MODE=review

# --- Agent runtime ---
AI_AGENT_MAX_TURNS=6
AI_MAX_CONTEXT_TOKENS=4000
AI_TIMEOUT_MS=15000
# Max retry attempts per ingestion event before it is marked FAILED.
AI_MAX_EVENT_ATTEMPTS=4