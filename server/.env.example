# --- Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000

# --- Database (Prisma ORM 7 / adapter-pg) ---
# Prisma generates the client with adapter-pg (src/lib/prisma.js).
# DATABASE_URL goes through Supabase pgbouncer transaction pooling.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- AI triage (POST /api/ai/triage) ---
# Shared-secret bearer token for channel adapters/webhooks (Authorization: Bearer or x-ingest-token).
# Unset => the triage endpoint is disabled (503).
AI_INGEST_TOKEN=

# Master kill-switch for the AI/model egress path. "false" disables every model
# call; triage still runs and tickets are still created deterministically
# (type TASK, priority MEDIUM). Defaults to "true".
AI_ENABLED=true

# Per-model-call timeout in milliseconds. A provider that hangs past this is
# aborted and the stage degrades to its deterministic fallback. 0 disables.
AI_TIMEOUT_MS=15000

# Per-request model-spend cap in total tokens (accumulated across all agent
# stages). When the running total would exceed this, the remaining model
# stages are skipped and the deterministic fallback is used (ticket is still
# created). 0 or unset => unlimited.
AI_MAX_TOKENS_PER_REQUEST=20000

# Provider/model for the triage agents (Vercel AI SDK).
# v1 supports "gemini" only; other providers plug into src/ai/model.js later.
AI_PROVIDER=gemini
# Google API key; GOOGLE_GENERATIVE_AI_API_KEY is preferred, GEMINI_API_KEY is a fallback.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Optional customer-facing draft reply. "false" or unset => no auto-reply unless
# the request explicitly passes autoReply:true.
AI_AUTO_REPLY=false